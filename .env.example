# メンテナンス（リニューアル中）表示の切替
# "true" のときだけ「現在リニューアル中です」画面を表示する。
# それ以外（未設定含む）は通常表示。
# ※ output: "export" の静的サイトのため、変更後は再ビルド／再デプロイが必要。
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Turnstile のサイトキー（公開してよい方の鍵）。
# 未設定のままビルドすると、お問い合わせフォームは送信不可の案内に切り替わる。
# ローカル確認では常に成功するテストキーを使える。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
